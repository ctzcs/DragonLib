#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_CameraBlock
{
    float4x4 ViewProjection;
};

struct vertex_main_out
{
    float4 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float4 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_CameraBlock& CameraBlock [[buffer(0)]])
{
    vertex_main_out out = {};
    out.gl_Position = CameraBlock.ViewProjection * float4(in.in_var_TEXCOORD0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    return out;
}
