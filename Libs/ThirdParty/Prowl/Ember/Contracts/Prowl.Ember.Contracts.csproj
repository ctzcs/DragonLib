<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(ProwlTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ship the docs that exist without warning on every self-evident member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Package metadata -->
    <PackageId>Prowl.Ember.Contracts</PackageId>
    <Title>Prowl.Ember.Contracts</Title>
    <Description>The dependency-free, AOT-safe attributes and lifecycle interfaces shared between Prowl.Ember (the hot reload engine) and the code being reloaded. Reference this from your runtime and game assemblies; reference the full Prowl.Ember only from your editor or host.</Description>
    <PackageTags>hot-reload;contracts;attributes;analyzer;prowl;dotnet;csharp</PackageTags>
  </PropertyGroup>

  <!-- Build the analyzer first (build-only, not a runtime reference) so its DLL exists to pack below. -->
  <ItemGroup>
    <ProjectReference Include="../Analyzers/Prowl.Ember.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the analyzer here so anything taking the contract also gets the rules guiding its use. -->
    <None Include="..\Analyzers\bin\$(Configuration)\netstandard2.0\Prowl.Ember.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('..\Analyzers\bin\$(Configuration)\netstandard2.0\Prowl.Ember.Analyzers.dll')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Ember" />
    <InternalsVisibleTo Include="Prowl.Ember.Tests" />
  </ItemGroup>

</Project>
