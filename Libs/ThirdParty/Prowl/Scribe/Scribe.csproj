<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(ProwlTargetFrameworksCompat)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Prowl.$(AssemblyName)</PackageId>
    <RootNamespace>Prowl.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>

    <Title>Prowl.Scribe</Title>
    <Description>TrueType font parser, glyph layout engine and dynamic atlas packing.</Description>
    <PackageTags>prowl;font;truetype;rasterizer;layout;rendering</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scribe.Tests" />
    <InternalsVisibleTo Include="Paper.Msdf.Tests" />
    <None Include="../LICENSE" Link="ThirdPartyNotices/Prowl-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../Msdfgen/LICENSE.txt" Link="ThirdPartyNotices/msdfgen-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../Msdfgen/runtimes/win-x64/native/DragonLib.Msdfgen.dll"
          Link="DragonLib.Msdfgen.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Vector/Vector.csproj" />
  </ItemGroup>

</Project>
