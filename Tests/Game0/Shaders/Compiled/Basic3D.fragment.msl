#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Basic3DLightBlock
{
    float4 LightDirection;
    float4 Ambient;
    float4 Diffuse;
};

struct fragment_main_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct fragment_main_in
{
    float3 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment fragment_main_out fragment_main(fragment_main_in in [[stage_in]], constant type_Basic3DLightBlock& Basic3DLightBlock [[buffer(0)]])
{
    fragment_main_out out = {};
    out.out_var_SV_Target0 = float4(fast::clamp(in.in_var_TEXCOORD1.xyz * (Basic3DLightBlock.Ambient.xyz + (Basic3DLightBlock.Diffuse.xyz * fast::clamp(dot(fast::normalize(in.in_var_TEXCOORD0), fast::normalize(-Basic3DLightBlock.LightDirection.xyz)), 0.0, 1.0))), float3(0.0), float3(1.0)), in.in_var_TEXCOORD1.w);
    return out;
}

