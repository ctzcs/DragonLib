#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VertexMatrixBlock
{
    float4x4 WorldViewProjection;
    float4x4 World;
};

struct type_ShadowMatrixBlock
{
    float4x4 LightViewProjection;
};

struct vertex_main_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_TEXCOORD1 [[user(locn1)]];
    float2 out_var_TEXCOORD2 [[user(locn2)]];
    float4 out_var_TEXCOORD3 [[user(locn3)]];
    float3 out_var_TEXCOORD4 [[user(locn4)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
    float4 in_var_TEXCOORD3 [[attribute(3)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_VertexMatrixBlock& VertexMatrixBlock [[buffer(0)]], constant type_ShadowMatrixBlock& ShadowMatrixBlock [[buffer(1)]])
{
    vertex_main_out out = {};
    float4 _50 = float4(in.in_var_TEXCOORD0, 1.0);
    float3x3 _60 = float3x3(float4(VertexMatrixBlock.World[0][0], VertexMatrixBlock.World[1][0], VertexMatrixBlock.World[2][0], VertexMatrixBlock.World[3][0]).xyz, float4(VertexMatrixBlock.World[0][1], VertexMatrixBlock.World[1][1], VertexMatrixBlock.World[2][1], VertexMatrixBlock.World[3][1]).xyz, float4(VertexMatrixBlock.World[0][2], VertexMatrixBlock.World[1][2], VertexMatrixBlock.World[2][2], VertexMatrixBlock.World[3][2]).xyz);
    float4 _72 = VertexMatrixBlock.World * _50;
    out.out_var_TEXCOORD0 = fast::normalize(in.in_var_TEXCOORD1 * _60);
    out.out_var_TEXCOORD1 = float4(fast::normalize(in.in_var_TEXCOORD3.xyz * _60), in.in_var_TEXCOORD3.w);
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD3 = ShadowMatrixBlock.LightViewProjection * float4(_72.xyz, 1.0);
    out.out_var_TEXCOORD4 = _72.xyz;
    out.gl_Position = VertexMatrixBlock.WorldViewProjection * _50;
    return out;
}

