#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VertexMatrixBlock
{
    float4x4 WorldViewProjection;
    float4x4 World;
};

struct vertex_main_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float3 out_var_TEXCOORD1 [[user(locn1)]];
    float4 out_var_TEXCOORD2 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float4 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_VertexMatrixBlock& VertexMatrixBlock [[buffer(0)]])
{
    vertex_main_out out = {};
    float4 _38 = float4(in.in_var_TEXCOORD0, 1.0);
    out.out_var_TEXCOORD0 = fast::normalize(in.in_var_TEXCOORD1 * float3x3(float4(VertexMatrixBlock.World[0][0], VertexMatrixBlock.World[1][0], VertexMatrixBlock.World[2][0], VertexMatrixBlock.World[3][0]).xyz, float4(VertexMatrixBlock.World[0][1], VertexMatrixBlock.World[1][1], VertexMatrixBlock.World[2][1], VertexMatrixBlock.World[3][1]).xyz, float4(VertexMatrixBlock.World[0][2], VertexMatrixBlock.World[1][2], VertexMatrixBlock.World[2][2], VertexMatrixBlock.World[3][2]).xyz));
    out.out_var_TEXCOORD1 = (VertexMatrixBlock.World * _38).xyz;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD2;
    out.gl_Position = VertexMatrixBlock.WorldViewProjection * _38;
    return out;
}

