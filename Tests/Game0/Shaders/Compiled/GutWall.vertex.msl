#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VertexMatrixBlock
{
    float4x4 Matrix;
};

struct type_CameraBlock
{
    float4x4 CameraMatrix;
};

struct vertex_main_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_VertexMatrixBlock& VertexMatrixBlock [[buffer(0)]], constant type_CameraBlock& CameraBlock [[buffer(1)]])
{
    vertex_main_out out = {};
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.gl_Position = VertexMatrixBlock.Matrix * (CameraBlock.CameraMatrix * float4(in.in_var_TEXCOORD0, 0.0, 1.0));
    return out;
}

